{
  "name": "sistema-procesamiento-de-notas",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "generate:sheet": "tsx packages/pdf-generator/generateSheet.ts",
    "compose:official": "tsx packages/pdf-generator/composeOfficialSheet.ts",
    "test": "vitest run",
    "debug:load": "tsx apps/cli/debugLoad.ts",
    "compare:threshold": "tsx apps/cli/compareThreshold.ts",
    "api": "tsx apps/api/server.ts",
    "web": "vite --config apps/web/vite.config.ts apps/web",
    "web:build": "vite build --config apps/web/vite.config.ts apps/web",
    "dev": "echo \"Corre en dos terminales:  npm run api   y   npm run web\"",
    "build": "npm run web:build",
    "start": "npm run api"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.6.3",
    "vite": "^6.0.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "tsx": "4.19.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "@napi-rs/canvas": "1.0.8",
    "@techstark/opencv-js": "5.0.0-release.1",
    "fastify": "^5.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "zod": "^3.24.1"
  }
}
